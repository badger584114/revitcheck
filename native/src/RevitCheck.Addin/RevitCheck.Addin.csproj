<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RevitCheck.Core\RevitCheck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF assemblies for BitmapImage (ribbon icons) and
         Microsoft.Win32.OpenFileDialog (per-run mapping/CSV pickers -
         MetadataReconciliationCommand). Plain framework references, same as
         any classic net48 project - no Nice3point/Revit dependency here. -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deployed alongside the built DLL so RevitCheckApplication can find
         them next to Assembly.GetExecutingAssembly().Location at runtime. -->
    <Content Include="Resources\Icons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="RevitCheck.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <!-- Revit 2024 add-ins run on .NET Framework 4.8. RevitCheck.Core stays
         netstandard2.0 so it's reusable unchanged when a future net8.0 Addin
         project is added for Revit 2025+ (PLANNING.md §12). -->
    <TargetFramework>net48</TargetFramework>
    <!-- RevitAPI.dll/RevitAPIUI.dll are provided at compile time by the
         Nice3point.Revit.Api.* NuGet packages below (community-maintained
         reference assemblies) since no Revit install exists on this machine.
         They must not be copied into the output or bundled into the add-in -
         Revit supplies the real assemblies at runtime. -->
  </PropertyGroup>

</Project>
